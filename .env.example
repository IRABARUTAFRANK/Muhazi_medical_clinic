# Server-side only (scripts, migrations, admin tasks). Never ship to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Postgres connection string from Supabase → Project settings → Database (for `supabase db push`)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Manager PIN used by `pnpm db:verify` (the t.mugabo PIN printed by seed-staff)
MANAGER_PIN=
