# Server-side only (scripts, migrations, admin tasks). Never ship to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Postgres connection string from Supabase → Project settings → Database (for `supabase db push`)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Manager PIN used by `pnpm db:verify` (the t.mugabo PIN printed by seed-staff)
MANAGER_PIN=

# Supabase personal access token (dashboard → Account → Access Tokens) for
# `pnpm sb:configure` (Auth settings, hook, function secrets) and `pnpm sb:deploy` (Edge Functions)
SUPABASE_ACCESS_TOKEN=sbp_...
# Public URL of the web app (site URL + allowed redirect for Supabase Auth)
SITE_URL=https://muhazimedicalclinicltd.vercel.app

# Mail provider for sign-in codes (one of them). With a key present, `pnpm sb:configure` enables
# the send-auth-email hook, which only sends codes after a PIN check.
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=Muhazi Medical Clinic <no-reply@example.com>
# Written back by sb:configure so re-runs keep the same hook secret
SEND_EMAIL_HOOK_SECRET=

# Optional custom SMTP for Supabase's own mailer (used when the hook is off)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=Muhazi Medical Clinic
SMTP_ADMIN_EMAIL=
