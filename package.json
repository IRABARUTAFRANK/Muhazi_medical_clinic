{
  "name": "muhazi-medical-clinic",
  "version": "0.1.0",
  "private": true,
  "description": "Muhazi Medical Clinic System — clinic management software for a polyclinic in Kayonza, Rwanda",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @mmc/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shots": "node scripts/screenshots.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:bundle": "node scripts/db-bundle.mjs",
    "db:apply": "node scripts/db-apply.mjs",
    "db:seed-staff": "node scripts/seed-staff.mjs",
    "db:verify": "node scripts/verify-live.mjs",
    "sb:configure": "node scripts/supabase-configure.mjs",
    "sb:deploy": "node scripts/supabase-deploy.mjs",
    "sb:set-email": "node scripts/set-staff-email.mjs",
    "sb:create-staff": "node scripts/create-staff.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@supabase/supabase-js": "2.118.0",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer-core": "^25.14.0",
    "typescript": "5.9.3"
  }
}
